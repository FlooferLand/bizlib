!version 1
set rae beach_bear
set faz bonnie

rae 166 {
	flow 1.6
	rotate "Jaw" x:-25.5
}

any 101 {
	flow in:0.3 out:0.3 grav_in:1.0 grav_out:1.0 smash_in:0.3 smash_out:0.3 smash_in_speed:0.5 smash_out_speed:0.5
	rotate "Head" x:-25
	move "Head" x:5.3
    type servo
}

rae 16bd {
	flow 1.0
	anim "body_lean"
}

rae 69td {
	flow 1.0
	anim "body_lean"
}

rae 67, faz 67 {
	flow 1.1
	anim "guitar_tilt"
}

faz 133, rae 113 {
    flow 0.6
    move "LeftEye" x:1
    move "RightEye" x:1
    type effect
}

faz 14td, rae 13td {
    flow 0.6
    move "LeftEye" x:-1
    move "RightEye" x:-1
}

rae 96td {
    flow 0.6
    move "Mouth" x:-1
    type servo
    hold yes
}
